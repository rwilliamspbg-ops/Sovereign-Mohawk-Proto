# Stage 1: Build the real fl-aggregator binary
FROM golang:1.27rc2-alpine AS builder

# Force the exact toolchain go.mod requires regardless of what the base
# image's own `go` binary reports -- see Dockerfile's identical comment
# for the observed CI failure this defends against.
ENV GOTOOLCHAIN=go1.26.6+auto

RUN apk add --no-cache git make

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o fl-aggregator ./cmd/fl-aggregator/main.go

# Stage 2: Final runtime image
FROM alpine:3.24

RUN apk add --no-cache ca-certificates tini bash coreutils curl gawk

RUN addgroup -S appgroup && adduser -S -G appgroup appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appgroup /app/fl-aggregator .

RUN mkdir -p /app/logs && chmod 777 /app/logs

# Load-test script: starts the real fl-aggregator binary (cmd/fl-aggregator)
# and drives real HTTP requests against its /fl/submit endpoint, measuring
# actual wall-clock latency/throughput. No simulated/estimated numbers -
# every figure in the output is derived from a real request that really
# happened against the real binary in this container.
RUN cat > /app/llm-training.sh << 'EOF'
#!/bin/bash
set -e

ROUNDS=${1:-100}
BATCH_SIZE=${2:-10}
LOG_DIR="/app/logs"
mkdir -p "$LOG_DIR"

export FL_AGGREGATOR_TOTAL_NODES=${FL_AGGREGATOR_TOTAL_NODES:-10000}
export FL_AGGREGATOR_MALICIOUS_NODES=${FL_AGGREGATOR_MALICIOUS_NODES:-3000}

echo "FL Aggregator Load Test"
echo "========================"
echo "Configuration:"
echo "  Rounds: $ROUNDS"
echo "  Gradients per round: $BATCH_SIZE"
echo "  Formal check: $FL_AGGREGATOR_TOTAL_NODES total / $FL_AGGREGATOR_MALICIOUS_NODES malicious nodes"
echo ""
echo "This runs the real ./fl-aggregator binary (cmd/fl-aggregator) and sends"
echo "it real HTTP requests. Every number below is measured, not simulated."
echo ""

./fl-aggregator &
AGGREGATOR_PID=$!
trap 'kill $AGGREGATOR_PID 2>/dev/null || true' EXIT

READY=0
for i in $(seq 1 30); do
  if curl -sf -o /dev/null -X POST http://localhost:8090/fl/submit -d '{"node_id":"readiness","grads":[]}' 2>/dev/null; then
    READY=1
    break
  fi
  if ! kill -0 "$AGGREGATOR_PID" 2>/dev/null; then
    echo "fl-aggregator exited before becoming ready" >&2
    exit 1
  fi
  sleep 0.2
done
if [ "$READY" -ne 1 ]; then
  echo "fl-aggregator did not become ready within 6s" >&2
  exit 1
fi

TOTAL_TIME_START_NS=$(date +%s%N)
SUCCESS_COUNT=0
FAIL_COUNT=0
TOTAL_LATENCY_MS=0

for ((round = 1; round <= ROUNDS; round++)); do
  GRADS=$(gawk -v n="$BATCH_SIZE" 'BEGIN{
    srand();
    printf "[";
    for (i = 0; i < n; i++) { printf "%s%.6f", (i > 0 ? "," : ""), (rand() * 2 - 1) }
    printf "]"
  }')
  PAYLOAD="{\"node_id\":\"round-$round\",\"grads\":$GRADS}"

  REQ_START_NS=$(date +%s%N)
  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -X POST http://localhost:8090/fl/submit \
    -H "Content-Type: application/json" -d "$PAYLOAD")
  REQ_END_NS=$(date +%s%N)
  LATENCY_MS=$(( (REQ_END_NS - REQ_START_NS) / 1000000 ))
  TOTAL_LATENCY_MS=$((TOTAL_LATENCY_MS + LATENCY_MS))

  if [ "$HTTP_CODE" = "200" ]; then
    SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
  else
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi

  if [ $((round % 10)) -eq 0 ] || [ $round -eq 1 ]; then
    echo "[Round $round/$ROUNDS] HTTP $HTTP_CODE | Latency: ${LATENCY_MS}ms"
  fi
  echo "$(date '+%Y-%m-%d %H:%M:%S') Round $round: HTTP $HTTP_CODE, ${LATENCY_MS}ms" >> "$LOG_DIR/training.log"
done

TOTAL_TIME_END_NS=$(date +%s%N)
TOTAL_TIME_MS=$(( (TOTAL_TIME_END_NS - TOTAL_TIME_START_NS) / 1000000 ))
AVG_LATENCY_MS=$((TOTAL_LATENCY_MS / ROUNDS))
THROUGHPUT=$(gawk -v r="$ROUNDS" -v t="$TOTAL_TIME_MS" 'BEGIN{printf "%.2f", (t > 0 ? r * 1000 / t : 0)}')

echo ""
echo "========================"
echo "Load Test Complete"
echo "========================"
echo "Results (measured against the real running binary):"
echo "  Successful requests: $SUCCESS_COUNT/$ROUNDS"
echo "  Failed requests: $FAIL_COUNT/$ROUNDS"
echo "  Total wall-clock time: ${TOTAL_TIME_MS}ms"
echo "  Average latency: ${AVG_LATENCY_MS}ms"
echo "  Measured throughput: ${THROUGHPUT} req/sec"
echo ""
echo "Log file: $LOG_DIR/training.log"
EOF

RUN chmod +x /app/llm-training.sh

USER appuser

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD test -f /app/logs/training.log || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/llm-training.sh", "100", "10"]
