# Copy this file to .env and fill in real values before running docker compose.
# Required by docker-compose.yml / docker-compose.phase3-staging.yml

# Grafana admin password (no insecure default is provided on purpose)
GRAFANA_ADMIN_PASSWORD=

# Grafana API token used by the ops-assistant service to query dashboards
GRAFANA_API_TOKEN=

# Frontend build-time (Vite) config for the ops-assistant client. Vite inlines
# VITE_* variables during `npm run build`, so these are passed to the image build
# as build args (see web/ops-assistant/Dockerfile and docker-compose.yml) rather
# than as runtime environment variables. Leave them unset/empty to use the
# client's same-origin defaults, which is correct for the compose deployment
# (the UI is served from the same origin that serves /api and /ws).
VITE_API_BASE_URL=
VITE_WS_URL=
# CopilotKit Cloud public API key. Only needed for CopilotKit Cloud premium
# features; the self-hosted runtime works without it, so leave empty unless you
# intend to use their hosted service.
VITE_COPILOT_PUBLIC_API_KEY=
